{
    "name": "smoench/opensearch-dsl",
    "description": "OpenSearch DSL library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "ONGR team"
        },
        {
            "name": "Handcrafted in the Alps Team",
            "homepage": "https://github.com/handcraftedinthealps/ElasticsearchDSL/graphs/contributors"
        },
        {
            "name": "Simon Mönch",
            "homepage": "https://github.com/smoench/OpenSearchDSL/graphs/contributors"
        }
    ],
    "require": {
        "php": "8.3.* || 8.4.* || 8.5.*",
        "opensearch-project/opensearch-php": "^2.3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.2",
        "phpstan/phpstan": "2.1.33",
        "phpstan/phpstan-phpunit": "2.0.10",
        "rector/rector": "2.2.14",
        "friendsofphp/php-cs-fixer": "3.91.3"
    },
    "autoload": {
        "psr-4": {
            "OpenSearchDSL\\": "src/"
        },
        "exclude-from-classmap": ["/tests/"]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSearchDSL\\Tests\\": "tests/"
        }
    }
}
